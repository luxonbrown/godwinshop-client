# GodwinShop client — environment template
# Copy to .env (or set VITE_API_URL via hosting dashboard) and fill in.
# NEVER commit the real .env file.

# API base URL. In dev, leave empty ('/api' + Vite proxy to localhost:5000).
# In production, set to the deployed backend, e.g. https://your-server.onrender.com/api
VITE_API_URL=